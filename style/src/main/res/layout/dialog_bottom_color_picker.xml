<?xml version="1.0" encoding="utf-8"?>
<!--
  调色盘（色盘 + 明度/饱和度渐变滑杆 + 色号输入框）
  - 圆盘角度=色相、半径=饱和度，右边滑杆调明度，下面滑杆调饱和度；
  - 顶部可以直接输入 #RRGGBB / #AARRGGBB 色号；
  - 底部一排常用颜色可一键选中。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_rounded_background"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <!-- 标题 + 确定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/color_picker_title"
            android:textColor="?attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/done"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_picker_done"
            android:focusable="true"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_baseline_check_24"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 预览 + 色号输入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/element_round_stroke_grey"
            android:padding="3dp">

            <View
                android:id="@+id/color_demo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/element_round_white" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/color_hex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="@string/color_picker_hex_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:textColor="?attr/textColorPrimary"
            android:textSize="16sp"
            tools:ignore="Autofill" />

        <TextView
            android:id="@+id/color_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/color_picker_apply"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 色盘 -->
    <com.stupidtree.style.widgets.ColorWheelView
        android:id="@+id/color_wheel"
        android:layout_width="188dp"
        android:layout_height="188dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp" />

    <!-- 明度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_value"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp" />

        <com.stupidtree.style.widgets.ColorSliderView
            android:id="@+id/color_value"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 饱和度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_saturation"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp" />

        <com.stupidtree.style.widgets.ColorSliderView
            android:id="@+id/color_sat"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 常用颜色（代码里动态填充） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/color_picker_presets"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/color_presets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
