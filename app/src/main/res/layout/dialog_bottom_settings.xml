<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_rounded_background"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="?attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_baseline_close_24"
            app:tint="?attr/textColorSecondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ===== 外观 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:text="@string/settings_group_appearance"
                android:textColor="?attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/row_theme"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_baseline_palette_24"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/tool_theme_name" />

                        <TextView
                            android:id="@+id/theme_value"
                            style="@style/settings_row_subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/row_timetable_style"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_nav_timetable"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/settings_timetable_style" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/settings_timetable_style_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 提醒 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="@string/settings_group_notify"
                android:textColor="?attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/row_notification"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_baseline_notifications_24"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/notify_settings_title" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/settings_notify_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 资料与数据 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="@string/settings_group_data"
                android:textColor="?attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/row_resources"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_baseline_format_list_bulleted_24"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/resource_browser_title" />

                        <TextView
                            android:id="@+id/resources_value"
                            style="@style/settings_row_subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/row_crawler"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_baseline_cloud_download_24"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/tool_crawler_name" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/tool_crawler_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/row_timetable_manager"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_list"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/tool_timetable_manager_name" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/tool_timetable_manager_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 关于 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="@string/settings_group_about"
                android:textColor="?attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/row_about"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_theme"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/tool_about_name" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/tool_about_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/row_ua"
                style="@style/settings_row_card">

                <LinearLayout style="@style/settings_row_inner">

                    <FrameLayout style="@style/settings_row_icon_frame">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:tint="?attr/colorPrimary"
                            android:tintMode="src_in"
                            app:srcCompat="@drawable/element_round_white_light" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_baseline_edit_note_24"
                            app:tint="?attr/colorPrimary" />
                    </FrameLayout>

                    <LinearLayout style="@style/settings_row_texts">

                        <TextView
                            style="@style/settings_row_title"
                            android:text="@string/name_ua_and_pp" />

                        <TextView
                            style="@style/settings_row_subtitle"
                            android:text="@string/settings_ua_desc" />
                    </LinearLayout>

                    <ImageView style="@style/settings_row_chevron" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
