<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      ============================================================================
      全局主题（v1.0.5 起支持「主题色可调」）
      ============================================================================
      结构：
        1) AppTheme            —— 基础主题，**只放与布局/背景相关的颜色**，主色由色板决定；
        2) AppTheme.Dark       —— 深色基础主题（显式给出深色取值，不依赖 values-night，
                                  这样运行时选色板不会和系统配置竞争）；
        3) AppTheme.<色板>     —— 各预设色板（浅色），只覆盖 colorPrimary 系；
        4) AppTheme.<色板>.Night —— 各预设色板的深色版本，只覆盖 colorPrimary 系。

      运行时：BaseActivity / BaseActivityCompose 在 super.onCreate() 之前调用
      ThemeTools.applyTheme(this)，由 ThemeTools 依据「昼夜模式 + 色板」setTheme 到具体 style。
      因为所有布局都用 ?attr/colorPrimary 引用主色，切换后全局自动跟随，无需逐个改 View。
    -->

    <!-- ======================= 1) 基础主题（浅色） ======================= -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cruel_summer_primary</item>
        <item name="colorPrimaryVariant">@color/cruel_summer_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorFade">#736dfe</item>
        <item name="colorPrimaryDisabled">@color/cruel_summer_primary_disabled</item>
        <item name="colorSecondary">@color/cruel_summer_primary</item>
        <item name="colorSecondaryVariant">@color/cruel_summer_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="backgroundColorBar">#70e7e7f2</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#00000000</item>
        <!-- Customize your theme here. -->
        <item name="backgroundColorBottom">#F6F7Fa</item>
        <item name="backgroundColorBottomAsTint">#CFFFFFFF</item>
        <item name="backgroundColorSecond">#FFFFFF</item>
        <item name="backgroundColorSecondAsTint">#CFFAFAFA</item>
        <item name="textColorPrimary">#FF000000</item>
        <item name="textColorSecondary">#FF808080</item>
        <item name="colorControlDisabled">#FFE0E0E0</item>
        <item name="backgroundIconColorBottom">#11304ffe</item>

        <!--透明状态栏-->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ======================= 2) 基础主题（深色，显式取值） ======================= -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="colorPrimary">@color/cruel_summer_fade</item>
        <item name="colorPrimaryVariant">@color/cruel_summer_fade</item>
        <item name="colorSecondary">@color/cruel_summer_fade</item>
        <item name="colorSecondaryVariant">@color/cruel_summer_fade</item>
        <item name="colorPrimaryDisabled">#77cbd4e2</item>
        <item name="colorFade">#736dfe</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="backgroundColorBar">#30e7e7f2</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="backgroundColorBottom">#FF000000</item>
        <item name="backgroundColorBottomAsTint">#bF242424</item>
        <item name="backgroundColorSecond">#FF121212</item>
        <item name="backgroundColorSecondAsTint">#6F242424</item>
        <item name="textColorPrimary">#FFffff</item>
        <item name="colorControlNormal">#44ffffff</item>
        <item name="textColorSecondary">#FF858585</item>
        <item name="colorControlDisabled">#ffE0E0E0</item>
        <item name="backgroundIconColorBottom">#33304ffe</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ======================= 3) 预设色板（浅色） ======================= -->
    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorSecondary">#1565C0</item>
        <item name="colorSecondaryVariant">#0D47A1</item>
        <item name="colorPrimaryDisabled">#BBD3EC</item>
        <item name="backgroundIconColorBottom">#151565C0</item>
    </style>

    <style name="AppTheme.Red" parent="AppTheme">
        <item name="colorPrimary">#C62828</item>
        <item name="colorPrimaryVariant">#8E0000</item>
        <item name="colorSecondary">#C62828</item>
        <item name="colorSecondaryVariant">#8E0000</item>
        <item name="colorPrimaryDisabled">#EDC4C4</item>
        <item name="backgroundIconColorBottom">#15C62828</item>
    </style>

    <style name="AppTheme.Purple" parent="AppTheme">
        <item name="colorPrimary">#6A1FB0</item>
        <item name="colorPrimaryVariant">#4A148C</item>
        <item name="colorSecondary">#6A1FB0</item>
        <item name="colorSecondaryVariant">#4A148C</item>
        <item name="colorPrimaryDisabled">#D9C4EC</item>
        <item name="backgroundIconColorBottom">#156A1FB0</item>
    </style>

    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">#E65100</item>
        <item name="colorPrimaryVariant">#BF360C</item>
        <item name="colorSecondary">#E65100</item>
        <item name="colorSecondaryVariant">#BF360C</item>
        <item name="colorPrimaryDisabled">#F7D2B8</item>
        <item name="backgroundIconColorBottom">#15E65100</item>
    </style>

    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">#00695C</item>
        <item name="colorPrimaryVariant">#004D40</item>
        <item name="colorSecondary">#00695C</item>
        <item name="colorSecondaryVariant">#004D40</item>
        <item name="colorPrimaryDisabled">#B8D8D3</item>
        <item name="backgroundIconColorBottom">#1500695C</item>
    </style>

    <style name="AppTheme.Graphite" parent="AppTheme">
        <item name="colorPrimary">#37474F</item>
        <item name="colorPrimaryVariant">#263238</item>
        <item name="colorSecondary">#37474F</item>
        <item name="colorSecondaryVariant">#263238</item>
        <item name="colorPrimaryDisabled">#CBd2d6</item>
        <item name="backgroundIconColorBottom">#1537474F</item>
    </style>

    <!-- ======================= 4) 预设色板（深色） ======================= -->
    <style name="AppTheme.Blue.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#4A90D9</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorSecondary">#4A90D9</item>
        <item name="colorSecondaryVariant">#1565C0</item>
        <item name="backgroundIconColorBottom">#334A90D9</item>
    </style>

    <style name="AppTheme.Red.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#E05A5A</item>
        <item name="colorPrimaryVariant">#C62828</item>
        <item name="colorSecondary">#E05A5A</item>
        <item name="colorSecondaryVariant">#C62828</item>
        <item name="backgroundIconColorBottom">#33E05A5A</item>
    </style>

    <style name="AppTheme.Purple.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#9B6BD6</item>
        <item name="colorPrimaryVariant">#6A1FB0</item>
        <item name="colorSecondary">#9B6BD6</item>
        <item name="colorSecondaryVariant">#6A1FB0</item>
        <item name="backgroundIconColorBottom">#339B6BD6</item>
    </style>

    <style name="AppTheme.Orange.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#F08A3C</item>
        <item name="colorPrimaryVariant">#E65100</item>
        <item name="colorSecondary">#F08A3C</item>
        <item name="colorSecondaryVariant">#E65100</item>
        <item name="backgroundIconColorBottom">#33F08A3C</item>
    </style>

    <style name="AppTheme.Teal.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#2E9E8F</item>
        <item name="colorPrimaryVariant">#00695C</item>
        <item name="colorSecondary">#2E9E8F</item>
        <item name="colorSecondaryVariant">#00695C</item>
        <item name="backgroundIconColorBottom">#332E9E8F</item>
    </style>

    <style name="AppTheme.Graphite.Night" parent="AppTheme.Dark">
        <item name="colorPrimary">#78909C</item>
        <item name="colorPrimaryVariant">#37474F</item>
        <item name="colorSecondary">#78909C</item>
        <item name="colorSecondaryVariant">#37474F</item>
        <item name="backgroundIconColorBottom">#3378909C</item>
    </style>

    <!-- ======================= 5) 自定义色板（由 PopUpColorPicker 取色） =======================
         运行时无法生成 style，所以「自定义」沿用默认色板的 style，
         自定义颜色在需要着色的地方由 ThemeTools.getCustomColor() 单独取用
         （目前用于：底部导航指示器、设置页色块预览、时间线/课表主色块）。 -->
    <style name="AppTheme.Custom" parent="AppTheme" />
    <style name="AppTheme.Custom.Night" parent="AppTheme.Dark" />


    <!-- 欢迎页的风格 -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <!-- <item name="android:windowIsTranslucent">true</item> -->
        <!-- 透明背景不要了 -->
    </style>


    <!--    圆角透明背景的BottomSheetDialog主题-->
    <style name="TransparentBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">400dp</item>
    </style>

    <style name="ToolBarTheme_Light" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorButtonNormal">#FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
        <item name="android:titleTextAppearance">@style/Toolbar_Light_TitleStyle</item>
    </style>

    <style name="Toolbar_Light_TitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="tab_text_appearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--水波纹风格-->
    <style name="button_ripple_white">
        <item name="android:colorControlHighlight">@color/white</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_control">
        <item name="android:colorControlHighlight">?attr/colorControlNormal</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_control_large">
        <item name="android:colorControlHighlight">?attr/colorControlNormal</item>
        <item name="android:radius">32dp</item>
    </style>


    <style name="unbound_ripple_white_light">
        <item name="android:colorControlHighlight">#44FFFFFF</item>
    </style>

    <style name="button_ripple_accent_little">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">16dp</item>
    </style>

    <style name="button_ripple_accent">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_accent_large">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">32dp</item>
    </style>


    <style name="text_style_18sp_bold_white">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="text_style_28sp_bold_white">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="text_style_18sp_bold_primary">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="text_style_30sp_bold_primary">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="AppTheme.AppWidgetContainer" parent="AppTheme.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>
